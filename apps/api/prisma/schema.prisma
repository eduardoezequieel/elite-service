// Esquema de datos de Elite Service — spec 001 (auth y RBAC dinamico).
//
// Regla que manda sobre todo este archivo: NO existen roles fijos. Los roles se
// crean a demanda desde la administracion y agrupan permisos por clave
// `module.action`. El catalogo de permisos vive en `@elite/shared` y el seed lo
// sincroniza aca; nada en el codigo depende del nombre de un rol.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7: la URL ya no vive en el esquema. Va en prisma.config.ts para las
// migraciones, y en el adaptador de @prisma/adapter-pg para el cliente.
datasource db {
  provider = "postgresql"
}

/// Una persona que entra al sistema. Nunca se elimina: se desactiva (RN-4).
model User {
  id           String @id @default(uuid()) @db.Uuid
  email        String @unique
  passwordHash String
  fullName     String

  /// Un usuario desactivado no puede iniciar sesion y sus sesiones vigentes
  /// dejan de ser validas: el guard revisa esto en cada request (RN-4).
  isActive Boolean @default(true)

  /// Marca del ultimo cambio de contrasena. Todo JWT emitido antes de esta
  /// fecha se rechaza, asi que reemplazar la contrasena invalida las sesiones
  /// abiertas de ese usuario (RN-10).
  passwordChangedAt DateTime @default(now())

  roles UserRole[]

  openedCashSessions CashSession[] @relation("CashSessionOpenedBy")
  closedCashSessions CashSession[] @relation("CashSessionClosedBy")

  statusEvents WorkOrderStatusEvent[] @relation("StatusEventUser")

  recordedPayments Payment[] @relation("PaymentRecordedBy")

  /// Cobros que cerro (059) y precios que autorizo (060).
  charges              Charge[]        @relation("ChargeChargedBy")
  authorizedItemPrices WorkOrderItem[] @relation("ItemPriceAuthorizedBy")

  /// Inventario y venta suelta (065).
  inventoryMovements       InventoryMovement[] @relation("InventoryMovementCreatedByUser")
  counterSales             CounterSale[]       @relation("CounterSaleCreatedBy")
  voidedCounterSales       CounterSale[]       @relation("CounterSaleVoidedBy")
  authorizedSaleItemPrices CounterSaleItem[]   @relation("SaleItemPriceAuthorizedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

/// Un rol creado a demanda. El nombre es dato, nunca logica (RN-1).
model Role {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique
  description String?

  /// El rol que crea y mantiene el seed (spec 074). Es el unico al que el seed
  /// le agrega permisos y el API no deja borrarlo ni quitarle `roles.manage`.
  /// Se identifica por esta marca, no por el nombre: renombrarlo es valido.
  isSystem Boolean @default(false)

  /// Un rol puede existir sin permisos: se crea vacio y se le asignan
  /// despues, sin recrearlo ni tocar a sus usuarios (RN-6b).
  permissions RolePermission[]
  users       UserRole[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("roles")
}

/// Una clave `module.action` del catalogo de `@elite/shared`. El seed la
/// sincroniza; no se puede asignar una clave que no exista aca (RN-2).
model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  key         String  @unique
  description String?

  roles RolePermission[]

  @@map("permissions")
}

/// Asignacion de un rol a un usuario. Los permisos efectivos son la union de
/// los permisos de todos sus roles (RN-3).
model UserRole {
  userId String @db.Uuid
  roleId String @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  assignedAt DateTime @default(now())

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

/// Asignacion de un permiso a un rol.
model RolePermission {
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

// ============================================================================
// spec 003 — Carwash: catalogo, tickets y cobro
//
// Dos sujetos, no dos roles (RN-0): `User` (arriba) entra con correo y ve la
// oficina; `Employee` entra con usuario y PIN y ve la pista. No hay FK entre
// ellos: son mundos separados y una misma persona que haga las dos cosas tiene
// dos cuentas.
//
// `WorkOrder`, `WorkOrderItem` y el catalogo estan pensados para que el taller
// los reutilice: por eso llevan `area`. En esta spec siempre es CARWASH.
// ============================================================================

/// Que parte del negocio atiende una categoria, un servicio o una orden.
/// WORKSHOP existe en el modelo para el taller; esta spec no lo ofrece en la
/// UI (RN-1).
enum BusinessArea {
  CARWASH
  WORKSHOP
}

/// Estados de una orden. Las transiciones validas son las de RN-9 y viven en el
/// dominio, no aca.
enum WorkOrderStatus {
  OPEN
  WASHING
  READY
  PAID
  VOID
}

/// `OTHER` (069): cheque, billetera, lo que no es los otros tres. Lleva
/// `description`; no entra al efectivo esperado.
enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  OTHER
}

/// Un turno de caja. Como maximo uno OPEN (indice parcial en la migracion).
enum CashSessionStatus {
  OPEN
  CLOSED
}

/// Quien trabaja en la pista. No tiene roles ni permisos: estar activo es su
/// autorizacion para anotar, descontar y marcar listo (RN-0).
model Employee {
  id       String @id @default(uuid()) @db.Uuid
  /// Usuario del empleado. Dato de oficina, NO credencial: a la pista se entra
  /// solo con el PIN (044 RN-1).
  username String @unique
  /// HMAC-SHA256 del PIN con PIN_PEPPER, en hexadecimal. Es determinista para
  /// poder encontrar al empleado POR el PIN, y unico porque dos empleados con
  /// el mismo PIN harian ambigua la entrada (044 RN-3, RN-4).
  pinHash  String @unique
  fullName String

  /// Un empleado desactivado no entra a la pista y sus sesiones dejan de valer
  /// (RN-13, mismo espiritu que RN-4 de 001).
  isActive Boolean @default(true)

  /// Marca del ultimo cambio de PIN. Todo JWT de pista emitido antes se
  /// rechaza (RN-18, mismo mecanismo que `passwordChangedAt`).
  pinChangedAt DateTime @default(now())

  openedOrders      WorkOrder[]            @relation("OrderOpenedByEmployee")
  assignments       WorkOrderAssignment[]
  commissionEntries CommissionEntry[]
  statusEvents      WorkOrderStatusEvent[] @relation("StatusEventEmployee")

  /// Lo que recibio por despacho (065 RN-10) y lo que saco desde la pista al
  /// agregar un producto a un lavado (RN-17).
  receivedDispatches InventoryMovement[] @relation("InventoryMovementEmployee")
  inventoryMovements InventoryMovement[] @relation("InventoryMovementCreatedByEmployee")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("employees")
}

/// El dueno del carro. Se desactiva, no se elimina (RN-13).
model Customer {
  id       String  @id @default(uuid()) @db.Uuid
  fullName String
  phone    String?

  vehicles   VehicleOwner[]
  workOrders WorkOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fullName])
  @@map("customers")
}

/// Tipo de carroceria. Es dato, no logica: la matriz de precios cuelga de aca
/// y el negocio puede agregar tipos sin tocar codigo.
model VehicleBodyType {
  id        String  @id @default(uuid()) @db.Uuid
  key       String  @unique
  name      String
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  vehicles   Vehicle[]
  prices     ServicePrice[]
  workOrders WorkOrder[]

  @@map("vehicle_body_types")
}

/// Un carro, identificado por su placa. Una placa = un vehiculo, se reutiliza
/// entre tickets (RN-12).
model Vehicle {
  id         String  @id @default(uuid()) @db.Uuid
  plate      String  @unique
  bodyTypeId String  @db.Uuid
  make       String?
  color      String?
  isActive   Boolean @default(true)

  bodyType   VehicleBodyType @relation(fields: [bodyTypeId], references: [id], onDelete: Restrict)
  owners     VehicleOwner[]
  workOrders WorkOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bodyTypeId])
  @@map("vehicles")
}

/// Quien es (y quien fue) el dueno de un vehiculo. Si cambia el cliente, el
/// dueno actual se actualiza y la fila vieja queda como historial (RN-12).
model VehicleOwner {
  vehicleId  String    @db.Uuid
  customerId String    @db.Uuid
  isCurrent  Boolean   @default(true)
  fromDate   DateTime  @default(now())
  toDate     DateTime?

  vehicle  Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@id([vehicleId, customerId, fromDate])
  @@index([customerId])
  @@index([vehicleId, isCurrent])
  @@map("vehicle_owners")
}

/// Agrupa servicios dentro de un area. Se desactiva, no se elimina (RN-13).
model ServiceCategory {
  id        String       @id @default(uuid()) @db.Uuid
  name      String
  area      BusinessArea
  sortOrder Int          @default(0)
  isActive  Boolean      @default(true)
  /// Sus servicios cuentan como extra en Rendimiento (067 RN-4): lo que se
  /// vende ademas del lavado. La categoria del lavado principal va en false.
  isExtra   Boolean      @default(true)

  services Service[]

  @@unique([area, name])
  @@map("service_categories")
}

/// Un servicio del catalogo. `defaultPrice` es el precio base con IVA incluido;
/// la matriz por tipo de carro es opcional y gana cuando existe (RN-2, RN-3).
model Service {
  id           String       @id @default(uuid()) @db.Uuid
  code         String       @unique
  name         String
  categoryId   String       @db.Uuid
  area         BusinessArea
  defaultPrice Decimal      @db.Decimal(12, 2)
  taxRate      Decimal      @default("0.1300") @db.Decimal(6, 4)
  isActive     Boolean      @default(true)

  category ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  prices   ServicePrice[]
  items    WorkOrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([area, isActive])
  @@map("services")
}

/// Precio de un servicio para un tipo de carro. Que no exista la fila NO
/// significa cero: significa "usar el precio base" (RN-2).
model ServicePrice {
  serviceId  String  @db.Uuid
  bodyTypeId String  @db.Uuid
  price      Decimal @db.Decimal(12, 2)

  service  Service         @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  bodyType VehicleBodyType @relation(fields: [bodyTypeId], references: [id], onDelete: Cascade)

  @@id([serviceId, bodyTypeId])
  @@index([bodyTypeId])
  @@map("service_prices")
}

/// Un lavado. El numero (`CW-0001`) es correlativo y publico; en pantalla se
/// muestra como `#14` (RN-15).
///
/// Un carro tiene como maximo un lavado sin cobrar (`OPEN`, `WASHING`, `READY`):
/// lo garantiza el unico parcial `work_orders_one_active_per_vehicle` (en la
/// migracion, 090 RN-1).
model WorkOrder {
  id     String          @id @default(uuid()) @db.Uuid
  number String          @unique
  area   BusinessArea
  status WorkOrderStatus @default(OPEN)

  /// Null si se abrió solo con la placa (040). El responsable vive en el carro.
  customerId String? @db.Uuid
  vehicleId  String  @db.Uuid
  /// Snapshot: el tipo de carro con el que se cotizo. Si cambia el vehiculo
  /// despues, este ticket no se recalcula (RN-4).
  bodyTypeId String  @db.Uuid

  notes String?

  /// Quien lo abrio. Uno de los dos, nunca ambos: la pista pone empleado, la
  /// oficina pone usuario y opcionalmente tambien empleado (RN-8).
  openedByEmployeeId String? @db.Uuid
  openedByUserId     String? @db.Uuid

  chargedByUserId String?   @db.Uuid
  chargedAt       DateTime?

  /// Cuando pasó a WASHING. Se limpia al volver a OPEN.
  washingStartedAt DateTime?

  /// Comision congelada al cobrar (009). `null` hasta PAID y en PAID anteriores
  /// a esa spec: no se recalcula.
  commissionTotal Decimal? @db.Decimal(12, 2)

  customer Customer?       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  vehicle  Vehicle         @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  bodyType VehicleBodyType @relation(fields: [bodyTypeId], references: [id], onDelete: Restrict)
  openedBy Employee?       @relation("OrderOpenedByEmployee", fields: [openedByEmployeeId], references: [id], onDelete: Restrict)

  items              WorkOrderItem[]
  assignments        WorkOrderAssignment[]
  payments           Payment[]
  commissionEntries  CommissionEntry[]
  statusEvents       WorkOrderStatusEvent[]
  /// `SALE` / `SALE_RETURN` de sus lineas de producto (065 RN-4, RN-5).
  inventoryMovements InventoryMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([area, status])
  @@index([createdAt])
  @@index([chargedAt])
  @@index([customerId])
  @@index([vehicleId])
  @@map("work_orders")
}

/// Una linea del ticket. Copia del catalogo al momento de agregarla: si el
/// catalogo cambia despues, los tickets viejos no se recalculan (RN-4).
///
/// Desde la 065 una linea es un servicio o un producto del inventario (`kind`).
model WorkOrderItem {
  id              String            @id @default(uuid()) @db.Uuid
  workOrderId     String            @db.Uuid
  /// Servicio o producto (065). Las lineas anteriores son todas SERVICE.
  kind            WorkOrderItemKind @default(SERVICE)
  /// Puede quedar nulo si el servicio se elimina algun dia; el snapshot de
  /// nombre y codigo es lo que manda. Siempre nulo en una linea PRODUCT.
  serviceId       String?           @db.Uuid
  /// Solo en lineas PRODUCT (065).
  inventoryItemId String?           @db.Uuid
  /// Cantidad con tres decimales (065 RN-6). Un servicio es siempre 1.
  quantity        Decimal           @default(1) @db.Decimal(12, 3)

  /// Snapshot de codigo y nombre de la linea, sea servicio o producto. No se
  /// renombran para no migrar el historial; `@elite/shared` los expone ademas
  /// como `code` / `name` (065).
  serviceCode  String
  serviceName  String
  /// Precio que mandaba el catalogo al agregar la linea. Es el techo del
  /// descuento (RN-5).
  catalogPrice Decimal @db.Decimal(12, 2)
  /// Precio que se cobra. Entre 0 y `catalogPrice` (RN-5).
  unitPrice    Decimal @db.Decimal(12, 2)
  taxRate      Decimal @db.Decimal(6, 4)
  sortOrder    Int     @default(0)

  /// Firma del precio autorizado (060 RN-1). Todo null = precio de catalogo o
  /// descuento hecho con el lavado abierto, que no pide autorizacion.
  priceAuthorizedByUserId String?   @db.Uuid
  priceAuthorizedAt       DateTime?
  priceReason             String?
  /// El precio que tenia la linea antes del cambio, para el historial.
  previousUnitPrice       Decimal?  @db.Decimal(12, 2)

  workOrder         WorkOrder      @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  service           Service?       @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  inventoryItem     InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  priceAuthorizedBy User?          @relation("ItemPriceAuthorizedBy", fields: [priceAuthorizedByUserId], references: [id], onDelete: SetNull)

  @@index([workOrderId])
  @@index([serviceId])
  @@index([inventoryItemId])
  @@map("work_order_items")
}

/// Quien lavo. Es el conjunto que cobra comision (009); `openedByEmployeeId`
/// sigue siendo quien abrio (003 RN-8).
model WorkOrderAssignment {
  workOrderId String   @db.Uuid
  employeeId  String   @db.Uuid
  assignedAt  DateTime @default(now())

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  employee  Employee  @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@id([workOrderId, employeeId])
  @@index([employeeId])
  @@map("work_order_assignments")
}

/// Quien movio el estado. Es el tipo de sesion, no un rol (046 RN-3).
enum StatusActorKind {
  USER
  EMPLOYEE
}

/// Que cuenta una fila del historial del lavado (060).
enum WorkOrderEventKind {
  STATUS
  PRICE_CHANGED
}

/// Una entrada a un estado (046). Tabla de solo agregar: no se edita ni se
/// borra, porque una linea de tiempo que se puede corregir no sirve de
/// auditoria. La fila se escribe en la misma transaccion que el cambio (RN-1).
model WorkOrderStatusEvent {
  id          String           @id @default(uuid()) @db.Uuid
  workOrderId String           @db.Uuid
  /// `null` solo en la fila de apertura del ticket.
  fromStatus  WorkOrderStatus?
  toStatus    WorkOrderStatus

  /// Que clase de entrada es (060). `STATUS` es el cambio de estado de la 046 y
  /// el unico que arma tramos en la linea de tiempo; `PRICE_CHANGED` es un
  /// cambio de precio autorizado, que no mueve el estado y por eso repite el
  /// que tenia el lavado en `fromStatus` y `toStatus`.
  kind WorkOrderEventKind @default(STATUS)

  /// Solo en `PRICE_CHANGED`: la linea y los dos precios del cambio, mas el
  /// motivo. El actor de la fila es **quien autorizo** (045 RN-5), que es lo
  /// que el dueno revisa al cierre.
  itemId            String?  @db.Uuid
  /// Nombre del servicio congelado al momento del cambio, igual que
  /// `actorName`: la linea de tiempo cuenta lo que paso, no como se llama hoy
  /// el servicio (046 RN-4).
  serviceName       String?
  previousUnitPrice Decimal? @db.Decimal(12, 2)
  newUnitPrice      Decimal? @db.Decimal(12, 2)
  reason            String?

  actorKind       StatusActorKind?
  actorUserId     String?          @db.Uuid
  actorEmployeeId String?          @db.Uuid
  /// Nombre congelado al momento del cambio. Si al empleado lo renombran o lo
  /// borran, la linea sigue diciendo quien fue (RN-4).
  actorName       String?

  occurredAt DateTime @default(now())

  workOrder     WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  actorUser     User?     @relation("StatusEventUser", fields: [actorUserId], references: [id], onDelete: SetNull)
  actorEmployee Employee? @relation("StatusEventEmployee", fields: [actorEmployeeId], references: [id], onDelete: SetNull)

  @@index([workOrderId, occurredAt])
  @@map("work_order_status_events")
}

/// Una parte de la comision de un ticket cobrado. El reporte lee estas filas,
/// no vuelve a aplicar la formula (009 RN-8). No se borra al desactivar al
/// empleado: `onDelete: Restrict`.
model CommissionEntry {
  id          String   @id @default(uuid()) @db.Uuid
  workOrderId String   @db.Uuid
  employeeId  String   @db.Uuid
  amount      Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  employee  Employee  @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([workOrderId, employeeId])
  @@index([employeeId])
  @@map("commission_entries")
}

/// Una cuenta de cobro (059). Junta 1..N lavados y 1..N pagos; el caso normal
/// es uno y uno. Nace cobrada: no existe una cuenta a medio pagar (RN-2), y
/// deshacerla es borrar la fila —los pagos se van con ella—, igual que el
/// reverso de la 045 borraba el pago suelto.
model Charge {
  id     String  @id @default(uuid()) @db.Uuid
  /// Correlativo publico `C-0001`, con el mismo criterio que el del lavado.
  number String  @unique
  /// Suma de los totales de los lavados, igual a la suma de los pagos (RN-3).
  total  Decimal @db.Decimal(12, 2)

  /// Efectivo que entrego el cliente y vuelto que se le dio (RN-10). Null si no
  /// hubo efectivo o si pago justo. El pago registrado sigue siendo el monto
  /// cobrado, no lo entregado: el turno cuadra contra el cobro.
  cashTendered Decimal? @db.Decimal(12, 2)
  changeGiven  Decimal? @db.Decimal(12, 2)

  chargedByUserId String   @db.Uuid
  cashSessionId   String   @db.Uuid
  chargedAt       DateTime @default(now())

  chargedBy   User         @relation("ChargeChargedBy", fields: [chargedByUserId], references: [id], onDelete: Restrict)
  cashSession CashSession  @relation(fields: [cashSessionId], references: [id], onDelete: Restrict)
  payments    Payment[]
  /// La venta suelta que cobro (065 RN-20). Nula en un cobro de lavados.
  counterSale CounterSale?

  createdAt DateTime @default(now())

  @@index([cashSessionId])
  @@index([chargedByUserId])
  @@index([chargedAt])
  @@map("charges")
}

/// Un renglon de pago, ya repartido por lavado (059 RN-5).
///
/// Desde la 059 `workOrderId` deja de ser unico: una cuenta escribe una fila
/// por metodo y por lavado, con la parte que le toco a ese lavado. El turno de
/// caja las lee como si fueran cobros separados (RN-9).
///
/// Desde la 065 un pago cuelga de un lavado **o** de una venta suelta, nunca de
/// los dos ni de ninguno: `CHECK (num_nonnulls("workOrderId", "counterSaleId")
/// = 1)` en la migracion (RN-20).
model Payment {
  id               String        @id @default(uuid()) @db.Uuid
  workOrderId      String?       @db.Uuid
  counterSaleId    String?       @db.Uuid
  /// Null = cobro anterior a la 059; se lee como hasta ahora y no tiene cuenta.
  chargeId         String?       @db.Uuid
  method           PaymentMethod
  amount           Decimal       @db.Decimal(12, 2)
  paidAt           DateTime      @default(now())
  recordedByUserId String        @db.Uuid
  /// Null = cobro anterior a la spec 010; no entra a ningun turno (RN-2).
  cashSessionId    String?       @db.Uuid
  /// 069: la cuenta del negocio a la que entro una TRANSFER. Null en los otros
  /// metodos y en transferencias anteriores a la 069 («Sin cuenta»).
  bankAccountId    String?       @db.Uuid
  /// 069: referencia del comprobante; solo TRANSFER.
  reference        String?
  /// 069: que fue el pago; solo OTHER.
  description      String?

  workOrder   WorkOrder?   @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  counterSale CounterSale? @relation(fields: [counterSaleId], references: [id], onDelete: Restrict)
  charge      Charge?      @relation(fields: [chargeId], references: [id], onDelete: Cascade)
  cashSession CashSession? @relation(fields: [cashSessionId], references: [id], onDelete: Restrict)
  bankAccount BankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)

  /// Quien cobro (053). La columna existe desde la 003; la relacion se agrega
  /// para que el nombre viaje en el ticket sin una segunda consulta.
  recordedBy User @relation("PaymentRecordedBy", fields: [recordedByUserId], references: [id], onDelete: Restrict)

  @@index([workOrderId])
  @@index([counterSaleId])
  @@index([chargeId])
  @@index([cashSessionId])
  @@index([recordedByUserId])
  @@index([bankAccountId])
  @@map("payments")
}

/// Un turno de la caja del lavado. Una sola caja fisica, implicita (RN-1).
///
/// Los totales de cierre son snapshot: no se recalculan despues. El indice
/// unico parcial `cash_sessions_one_open` (en la migracion) garantiza a lo
/// sumo una fila OPEN aunque dos cajeros abran a la vez.
model CashSession {
  id             String            @id @default(uuid()) @db.Uuid
  status         CashSessionStatus
  openedByUserId String            @db.Uuid
  openedAt       DateTime          @default(now())
  openingFloat   Decimal           @db.Decimal(12, 2)
  closedByUserId String?           @db.Uuid
  closedAt       DateTime?
  countedCash    Decimal?          @db.Decimal(12, 2)
  cashTotal      Decimal?          @db.Decimal(12, 2)
  cardTotal      Decimal?          @db.Decimal(12, 2)
  transferTotal  Decimal?          @db.Decimal(12, 2)
  /// 069 RN-7: suma de los pagos OTHER. No entra a expectedCash.
  otherTotal     Decimal?          @db.Decimal(12, 2)
  expectedCash   Decimal?          @db.Decimal(12, 2)
  differenceCash Decimal?          @db.Decimal(12, 2)
  notes          String?

  openedBy User      @relation("CashSessionOpenedBy", fields: [openedByUserId], references: [id], onDelete: Restrict)
  closedBy User?     @relation("CashSessionClosedBy", fields: [closedByUserId], references: [id], onDelete: Restrict)
  payments Payment[]
  charges  Charge[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([openedAt])
  @@map("cash_sessions")
}

// ============================================================================
// spec 065 — Inventario y venta suelta
//
// Un solo inventario con dos tipos de articulo: el producto se vende (en el
// lavado o suelto) y sale al agregarlo; el insumo no se vende, se despacha a un
// empleado desde la oficina. Los dos comparten kardex, categorias, entradas,
// ajustes y alertas de minimo.
// ============================================================================

/// Un articulo, un tipo, fijo desde el alta (RN-1).
enum InventoryItemKind {
  PRODUCT
  SUPPLY
}

/// Que movio la existencia (RN-2).
enum InventoryMovementType {
  ENTRY
  SALE
  SALE_RETURN
  DISPATCH
  ADJUSTMENT
  /// Lo que un trabajador toma, sin cobrarse (070).
  CONSUMPTION
  /// La anulacion de un CONSUMPTION (070 RN-6).
  CONSUMPTION_RETURN
}

/// Que es una linea del lavado (065).
enum WorkOrderItemKind {
  SERVICE
  PRODUCT
}

/// Una venta suelta nace cobrada y se anula, no se borra (RN-18, RN-22).
enum CounterSaleStatus {
  PAID
  VOID
}

/// Categoria propia del inventario, no la de servicios (RN-16). Se desactiva,
/// no se borra (RN-14). Tiene tipo, fijo desde el alta como el del articulo
/// (072): el nombre es unico por tipo y solo agrupa articulos de su tipo.
model InventoryCategory {
  id        String            @id @default(uuid()) @db.Uuid
  kind      InventoryItemKind
  name      String
  sortOrder Int               @default(0)
  isActive  Boolean           @default(true)

  items InventoryItem[]

  @@unique([kind, name])
  @@map("inventory_categories")
}

/// Un articulo del inventario. Se desactiva, no se borra (RN-14).
model InventoryItem {
  id               String            @id @default(uuid()) @db.Uuid
  /// Correlativo `INV-0001`, generado por el API (RN-15).
  code             String            @unique
  barcode          String?           @unique
  name             String
  kind             InventoryItemKind
  categoryId       String?           @db.Uuid
  unit             String            @default("unidad")
  /// Precio de venta con IVA. 0 para SUPPLY (RN-1).
  price            Decimal           @default(0) @db.Decimal(12, 2)
  taxRate          Decimal           @default("0.1300") @db.Decimal(6, 4)
  /// Costo promedio ponderado (RN-11).
  averageCost      Decimal           @default(0) @db.Decimal(12, 2)
  /// Copia del ultimo balanceAfter (RN-2).
  stockOnHand      Decimal           @default(0) @db.Decimal(12, 3)
  minStock         Decimal           @default(0) @db.Decimal(12, 3)
  /// true mientras este en o bajo el minimo y ya se aviso (RN-13).
  lowStockNotified Boolean           @default(false)
  isActive         Boolean           @default(true)

  category         InventoryCategory?  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  movements        InventoryMovement[]
  orderItems       WorkOrderItem[]
  counterSaleItems CounterSaleItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind, isActive])
  @@index([name])
  @@index([categoryId])
  @@map("inventory_items")
}

/// Una fila del kardex. Append-only (RN-2): nunca se edita ni se borra, se
/// corrige con otra. Cantidad con signo: + entra, - sale.
model InventoryMovement {
  id                  String                @id @default(uuid()) @db.Uuid
  itemId              String                @db.Uuid
  type                InventoryMovementType
  quantity            Decimal               @db.Decimal(12, 3)
  balanceAfter        Decimal               @db.Decimal(12, 3)
  /// Solo ENTRY (RN-11).
  unitCost            Decimal?              @db.Decimal(12, 2)
  /// ENTRY: factura o proveedor, texto libre.
  reference           String?
  /// ADJUSTMENT: motivo obligatorio (RN-12). DISPATCH: la nota opcional.
  reason              String?
  /// SALE / SALE_RETURN de un lavado (RN-4, RN-5).
  workOrderId         String?               @db.Uuid
  /// SALE / SALE_RETURN de una venta suelta (RN-19, RN-22).
  counterSaleId       String?               @db.Uuid
  /// DISPATCH: quien recibio (RN-10). CONSUMPTION / CONSUMPTION_RETURN: quien tomo (070).
  employeeId          String?               @db.Uuid
  /// CONSUMPTION: precio de venta al anotar (070 RN-4). CONSUMPTION_RETURN: copia del original.
  unitPrice           Decimal?              @db.Decimal(12, 2)
  /// CONSUMPTION_RETURN: el consumo que anula (070 RN-6). Unico: se anula una vez.
  reversesMovementId  String?               @unique @db.Uuid
  /// Quien lo registro desde oficina. Null = pista.
  createdByUserId     String?               @db.Uuid
  /// Quien lo registro desde la pista (SALE desde la tablet, RN-17).
  createdByEmployeeId String?               @db.Uuid
  createdAt           DateTime              @default(now())

  item              InventoryItem      @relation(fields: [itemId], references: [id], onDelete: Restrict)
  workOrder         WorkOrder?         @relation(fields: [workOrderId], references: [id], onDelete: Restrict)
  counterSale       CounterSale?       @relation(fields: [counterSaleId], references: [id], onDelete: Restrict)
  employee          Employee?          @relation("InventoryMovementEmployee", fields: [employeeId], references: [id], onDelete: Restrict)
  createdByUser     User?              @relation("InventoryMovementCreatedByUser", fields: [createdByUserId], references: [id], onDelete: Restrict)
  createdByEmployee Employee?          @relation("InventoryMovementCreatedByEmployee", fields: [createdByEmployeeId], references: [id], onDelete: Restrict)
  reverses          InventoryMovement? @relation("InventoryMovementReversal", fields: [reversesMovementId], references: [id], onDelete: Restrict)
  reversedBy        InventoryMovement? @relation("InventoryMovementReversal")

  @@index([itemId, createdAt])
  @@index([type, createdAt])
  @@index([workOrderId])
  @@index([counterSaleId])
  @@index([employeeId])
  @@map("inventory_movements")
}

/// Venta suelta `V-0001` (RN-18). Nace cobrada; se anula, no se borra: el
/// kardex la referencia (RN-22).
model CounterSale {
  id              String            @id @default(uuid()) @db.Uuid
  number          String            @unique
  status          CounterSaleStatus @default(PAID)
  /// Nombre libre, sin ficha de cliente (RN-21).
  customerName    String?
  total           Decimal           @db.Decimal(12, 2)
  /// La cuenta de la 059 que la cobro. Null tras anular: el cobro se borra y
  /// sus pagos se van con el (RN-22).
  chargeId        String?           @unique @db.Uuid
  createdByUserId String            @db.Uuid
  createdAt       DateTime          @default(now())
  voidedByUserId  String?           @db.Uuid
  voidedAt        DateTime?
  voidReason      String?

  charge    Charge?             @relation(fields: [chargeId], references: [id], onDelete: SetNull)
  createdBy User                @relation("CounterSaleCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  voidedBy  User?               @relation("CounterSaleVoidedBy", fields: [voidedByUserId], references: [id], onDelete: Restrict)
  items     CounterSaleItem[]
  payments  Payment[]
  movements InventoryMovement[]

  @@index([createdAt])
  @@index([createdByUserId])
  @@map("counter_sales")
}

/// Una linea de la venta: snapshot del articulo al venderlo (RN-6, RN-21).
model CounterSaleItem {
  id                      String  @id @default(uuid()) @db.Uuid
  counterSaleId           String  @db.Uuid
  inventoryItemId         String  @db.Uuid
  code                    String
  name                    String
  catalogPrice            Decimal @db.Decimal(12, 2)
  unitPrice               Decimal @db.Decimal(12, 2)
  quantity                Decimal @db.Decimal(12, 3)
  taxRate                 Decimal @db.Decimal(6, 4)
  /// Firma de un precio por debajo del catalogo (060, RN-21).
  priceAuthorizedByUserId String? @db.Uuid
  priceReason             String?
  sortOrder               Int     @default(0)

  counterSale       CounterSale   @relation(fields: [counterSaleId], references: [id], onDelete: Cascade)
  inventoryItem     InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  priceAuthorizedBy User?         @relation("SaleItemPriceAuthorizedBy", fields: [priceAuthorizedByUserId], references: [id], onDelete: SetNull)

  @@index([counterSaleId])
  @@index([inventoryItemId])
  @@map("counter_sale_items")
}

// ============================================================================
// spec 069 — Cuentas bancarias del negocio
//
// La cuenta a la que entra una transferencia. El banco es un codigo de la lista
// fija `BANKS` de @elite/shared (RN-1): agregar uno no toca la base. No se
// borra nunca: desactivada deja de elegirse y los pagos viejos la conservan.
// ============================================================================

enum BankAccountType {
  SAVINGS
  CHECKING
}

model BankAccount {
  id         String          @id @default(uuid()) @db.Uuid
  /// Codigo de RN-1 (`BANKS`), validado en shared.
  bank       String
  type       BankAccountType
  /// Sin guiones (RN-2).
  number     String
  holderName String
  active     Boolean         @default(true)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  payments Payment[]

  @@unique([bank, number])
  @@map("bank_accounts")
}

// ============================================================================
// specs 095-100 — Renta de carros (Riveras Rent a Car)
//
// Otro negocio de la familia: ninguna tabla de aca referencia `customers`,
// `vehicles`, `work_orders`, `cash_sessions` ni `bank_accounts` (095 RN-1). El
// unico cruce con el lavado es la placa, como texto. La 095 deja la migracion
// completa; 096, 098, 099 y 100 no tocan el schema.
// ============================================================================

// ===================== spec 095: flota, clientes de renta, ajustes, archivos =====================
enum FleetVehicleCategory {
  SEDAN
  HATCHBACK
  SUV
  PICKUP
  VAN
  OTHER
}

enum FleetVehicleStatus {
  ACTIVE
  IN_SHOP
  RETIRED
}

model FleetVehicle {
  id                    String               @id @default(uuid()) @db.Uuid
  plate                 String?              @unique
  make                  String
  model                 String
  year                  Int?
  color                 String?
  category              FleetVehicleCategory @default(SEDAN)
  status                FleetVehicleStatus   @default(ACTIVE)
  dailyRate             Decimal              @db.Decimal(12, 2)
  weeklyRate            Decimal?             @db.Decimal(12, 2)
  monthlyRate           Decimal?             @db.Decimal(12, 2)
  freeKmPerDay          Int?
  extraKmPrice          Decimal?             @db.Decimal(12, 2)
  odometerKm            Int                  @default(0)
  purchasePrice         Decimal?             @db.Decimal(12, 2)
  purchasedAt           DateTime?            @db.Date
  financed              Boolean              @default(false)
  downPayment           Decimal?             @db.Decimal(12, 2)
  installment           Decimal?             @db.Decimal(12, 2)
  termMonths            Int?
  financingStartedAt    DateTime?            @db.Date
  insuranceMonthly      Decimal?             @db.Decimal(12, 2)
  gpsMonthly            Decimal?             @db.Decimal(12, 2)
  otherFixedMonthly     Decimal?             @db.Decimal(12, 2)
  insuranceExpiresAt    DateTime?            @db.Date
  registrationExpiresAt DateTime?            @db.Date
  notes                 String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  agreements      RentalAgreement[]
  fines           RentalFine[]
  maintenanceLogs MaintenanceLog[]
  expenses        FleetExpense[]

  @@index([status])
  @@map("fleet_vehicles")
}

model RentalCustomer {
  id               String    @id @default(uuid()) @db.Uuid
  fullName         String
  documentId       String?
  licenseNumber    String?
  licenseExpiresAt DateTime? @db.Date
  birthDate        DateTime? @db.Date
  country          String?
  mobilePhone      String?
  phone            String?
  email            String?
  address          String?
  occupation       String?
  workplace        String?
  permanentAddress String?
  permanentPhone   String?
  representative   String?
  isActive         Boolean   @default(true)
  isBlocked        Boolean   @default(false)
  blockReason      String?
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  agreements RentalAgreement[]

  @@index([fullName])
  @@index([documentId])
  @@map("rental_customers")
}

model RentalSettings {
  key                 String   @id @default("default")
  companyName         String
  taxId               String?
  nrc                 String?
  address             String?
  phones              String?
  email               String?
  lessorName          String
  city                String   @default("San Salvador")
  contractStartNumber Int      @default(733)
  vatRate             Decimal  @default(0) @db.Decimal(5, 2)
  defaultCdwPerDay    Decimal? @db.Decimal(12, 2)
  defaultDeductible   Decimal? @db.Decimal(12, 2)
  bufferHours         Int      @default(1)
  graceHours          Int      @default(1)
  minDriverAge        Int      @default(21)
  kmAlert             Int      @default(500)
  daysAlert           Int      @default(7)
  interestRate        Decimal? @db.Decimal(5, 2)
  lateInterestRate    Decimal? @db.Decimal(5, 2)
  contractIntro       String
  clauses             Json // string[]
  accessories         Json // string[]
  logoFileId          String?  @db.Uuid
  updatedAt           DateTime @updatedAt

  @@map("rental_settings")
}

enum StoredFileKind {
  INSPECTION_PHOTO
  LOGO
}

model StoredFile {
  id              String         @id @default(uuid()) @db.Uuid
  kind            StoredFileKind
  mimeType        String
  sizeBytes       Int
  storedName      String
  createdByUserId String         @db.Uuid
  createdAt       DateTime       @default(now())

  @@map("stored_files")
}

// ===================== spec 096: rentas =====================
enum RentalAgreementStatus {
  RESERVED
  IN_PROGRESS
  FINISHED
  CANCELLED
}

enum RentalCoverage {
  UNDEFINED
  ACCEPTED
  DECLINED
}

model RentalAgreement {
  id                     String                @id @default(uuid()) @db.Uuid
  contractNumber         Int?                  @unique
  status                 RentalAgreementStatus @default(RESERVED)
  customerId             String                @db.Uuid
  vehicleId              String                @db.Uuid
  plannedPickupAt        DateTime
  plannedReturnAt        DateTime
  actualPickupAt         DateTime?
  actualReturnAt         DateTime?
  pickupLocation         String                @default("Oficina")
  returnLocation         String                @default("Oficina")
  dailyRate              Decimal               @db.Decimal(12, 2)
  billableDays           Int
  cdwPerDay              Decimal               @default(0) @db.Decimal(12, 2)
  deductible             Decimal               @default(0) @db.Decimal(12, 2)
  coverage               RentalCoverage        @default(UNDEFINED)
  includesVat            Boolean               @default(true)
  extraCharges           Decimal               @default(0) @db.Decimal(12, 2)
  extraChargesNote       String?
  discount               Decimal               @default(0) @db.Decimal(12, 2)
  extraKmCharge          Decimal               @default(0) @db.Decimal(12, 2)
  deposit                Decimal               @default(0) @db.Decimal(12, 2)
  depositMethod          PaymentMethod?
  depositReturnedAmount  Decimal?              @db.Decimal(12, 2)
  depositReturnedAt      DateTime?
  depositReturnNote      String?
  depositTransferredToId String?               @unique @db.Uuid
  cardLast4              String?
  authorizationCode      String?
  authorizationAmount    Decimal?              @db.Decimal(12, 2)
  authorizationDate      DateTime?             @db.Date
  additionalDriver       Json? // { name, licenseNumber, licenseExpiresAt, birthDate, country }
  pickupInspection       Json? // RentalInspection (shared)
  returnInspection       Json?
  pickupOdometerKm       Int?
  returnOdometerKm       Int?
  previousAgreementId    String?               @unique @db.Uuid
  swapReason             String?
  cancelReason           String?
  cancelledAt            DateTime?
  notes                  String?
  createdByUserId        String                @db.Uuid
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  customer   RentalCustomer    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  vehicle    FleetVehicle      @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  previous   RentalAgreement?  @relation("AgreementSwap", fields: [previousAgreementId], references: [id], onDelete: Restrict)
  next       RentalAgreement?  @relation("AgreementSwap")
  extensions RentalExtension[]
  payments   RentalPayment[]
  fines      RentalFine[]

  @@index([status])
  @@index([vehicleId, status])
  @@index([customerId])
  @@index([plannedPickupAt])
  @@index([plannedReturnAt])
  @@map("rental_agreements")
}

model RentalExtension {
  id               String   @id @default(uuid()) @db.Uuid
  agreementId      String   @db.Uuid
  previousReturnAt DateTime
  newReturnAt      DateTime
  addedDays        Int
  note             String?
  createdByUserId  String   @db.Uuid
  createdAt        DateTime @default(now())

  agreement RentalAgreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)

  @@index([agreementId])
  @@map("rental_extensions")
}

// ===================== spec 098: dinero =====================
model RentalPayment {
  id               String        @id @default(uuid()) @db.Uuid
  agreementId      String        @db.Uuid
  amount           Decimal       @db.Decimal(12, 2)
  method           PaymentMethod
  reference        String?
  paidAt           DateTime      @default(now())
  note             String?
  receivedByUserId String        @db.Uuid
  voidedAt         DateTime?
  voidReason       String?
  voidedByUserId   String?       @db.Uuid
  createdAt        DateTime      @default(now())

  agreement RentalAgreement @relation(fields: [agreementId], references: [id], onDelete: Restrict)

  @@index([agreementId])
  @@index([paidAt])
  @@map("rental_payments")
}

model RentalFine {
  id                String   @id @default(uuid()) @db.Uuid
  vehicleId         String   @db.Uuid
  agreementId       String?  @db.Uuid
  occurredAt        DateTime
  amount            Decimal  @db.Decimal(12, 2)
  description       String
  chargedToCustomer Boolean  @default(false)
  createdByUserId   String   @db.Uuid
  createdAt         DateTime @default(now())

  vehicle   FleetVehicle     @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  agreement RentalAgreement? @relation(fields: [agreementId], references: [id], onDelete: SetNull)

  @@index([vehicleId])
  @@index([agreementId])
  @@map("rental_fines")
}

// ===================== spec 099: mantenimiento y gastos =====================
model MaintenancePlanTask {
  id           String  @id @default(uuid()) @db.Uuid
  key          String  @unique
  name         String
  intervalKm   Int?
  intervalDays Int?
  sortOrder    Int     @default(0)
  isActive     Boolean @default(true)

  logs MaintenanceLog[]

  @@map("maintenance_plan_tasks")
}

model MaintenanceLog {
  id              String   @id @default(uuid()) @db.Uuid
  vehicleId       String   @db.Uuid
  taskId          String?  @db.Uuid
  performedAt     DateTime @db.Date
  odometerKm      Int?
  cost            Decimal? @db.Decimal(12, 2)
  shop            String?
  notes           String?
  createdByUserId String   @db.Uuid
  createdAt       DateTime @default(now())

  vehicle FleetVehicle         @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  task    MaintenancePlanTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)
  expense FleetExpense?

  @@index([vehicleId, performedAt])
  @@map("maintenance_logs")
}

enum FleetExpenseType {
  MAINTENANCE
  TIRES
  REPAIR
  FINE
  FUEL
  INSURANCE
  GPS
  WASH
  OTHER
}

model FleetExpense {
  id               String           @id @default(uuid()) @db.Uuid
  vehicleId        String           @db.Uuid
  type             FleetExpenseType
  amount           Decimal          @db.Decimal(12, 2)
  incurredAt       DateTime         @db.Date
  odometerKm       Int?
  description      String?
  maintenanceLogId String?          @unique @db.Uuid
  createdByUserId  String           @db.Uuid
  createdAt        DateTime         @default(now())

  vehicle        FleetVehicle    @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  maintenanceLog MaintenanceLog? @relation(fields: [maintenanceLogId], references: [id], onDelete: SetNull)

  @@index([vehicleId, incurredAt])
  @@map("fleet_expenses")
}
