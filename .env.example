# Copia este archivo a .env y ajusta los valores. Nunca subas .env al repositorio.

# --- API (NestJS) ---
API_PORT=3200
# En Render, PORT lo inyecta la plataforma y Nest lo usa. En local no toques
# ese valor para el API: PORT de este archivo es el de Next, y Nest se queda
# con API_PORT (ver apps/api/src/listen-port.ts).

# --- Web (Next.js) ---
PORT=3100
# Origen del front, para CORS del API. En desarrollo tambien se acepta cualquier
# localhost / 127.0.0.1 (ver apps/api/src/main.ts). En Render: URL de Vercel.
WEB_ORIGIN=http://localhost:3100
# Las variables NEXT_PUBLIC_* se exponen al navegador: no pongas secretos aqui.
# Same-origin: el browser pega a /api y Next reenvia a Nest (API_PORT / API_UPSTREAM).
# En Vercel NO setees NEXT_PUBLIC_API_URL. Setea API_UPSTREAM a la URL publica
# de Render, sin slash final (el rewrite se fija en el build).
NEXT_PUBLIC_API_URL=/api
# Opcional en local. En Vercel es obligatorio y apunta a Render.
# API_UPSTREAM=http://127.0.0.1:3200

# --- PostgreSQL (docker-compose) ---
POSTGRES_USER=elite
POSTGRES_PASSWORD=change_me
POSTGRES_DB=elite_service
POSTGRES_PORT=5435

# --- Base de datos (Prisma) ---
# Local (docker compose). En Render: URL DIRECTA de Neon (el host NO lleva
# "-pooler"), con sslmode=require. Distinta a esta. Solo en el dashboard.
DATABASE_URL=postgresql://elite:change_me@localhost:5435/elite_service?schema=public
# DATABASE_URL=postgresql://USER:PASSWORD@ep-example.region.aws.neon.tech/neondb?sslmode=require

# --- Auth (spec 001) ---
# Secreto de firma del JWT. Genera uno propio por entorno:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change_me_use_a_long_random_value

# --- PIN de pista (spec 044) ---
# Secreto con el que se convierte el PIN del empleado (HMAC-SHA256). Vive solo
# aca: la base guarda el resultado, nunca el PIN. Genera uno propio por entorno:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Cambiarlo invalida TODOS los PINs a la vez: hay que reasignarlos desde oficina.
PIN_PEPPER=change_me_use_another_long_random_value

# Usuario administrador inicial. El seed solo lo crea si no hay ningun usuario.
ADMIN_EMAIL=admin@elite.local
ADMIN_PASSWORD=change_me_at_least_8_chars
