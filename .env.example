# Copia este archivo a .env y ajusta los valores. Nunca subas .env al repositorio.

# --- API (NestJS) ---
API_PORT=3001

# --- Web (Next.js) ---
# Las variables NEXT_PUBLIC_* se exponen al navegador: no pongas secretos aqui.
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# --- PostgreSQL (docker-compose) ---
POSTGRES_USER=elite
POSTGRES_PASSWORD=change_me
POSTGRES_DB=elite_service
POSTGRES_PORT=5432

# --- Base de datos (Prisma) ---
DATABASE_URL=postgresql://elite:change_me@localhost:5432/elite_service?schema=public

# --- Auth (spec 001) ---
# Secreto de firma del JWT. Genera uno propio por entorno:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change_me_use_a_long_random_value

# Usuario administrador inicial. El seed solo lo crea si no hay ningun usuario.
ADMIN_EMAIL=admin@elite.local
ADMIN_PASSWORD=change_me_at_least_8_chars
