# Copia este archivo a .env y ajusta los valores. Nunca subas .env al repositorio.

# --- API (NestJS) ---
API_PORT=3001

# --- Web (Next.js) ---
# Las variables NEXT_PUBLIC_* se exponen al navegador: no pongas secretos aqui.
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# --- PostgreSQL (docker-compose) ---
POSTGRES_USER=elite
POSTGRES_PASSWORD=change_me
POSTGRES_DB=elite_service
POSTGRES_PORT=5432

# --- Futuro (spec de datos aun no aprobada) ---
# Se habilita cuando se apruebe la primera spec que requiera persistencia (Prisma).
# DATABASE_URL=postgresql://elite:change_me@localhost:5432/elite_service?schema=public
